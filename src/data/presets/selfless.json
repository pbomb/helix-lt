{
  "preset_name": "Selfless",
  "artist": "The Strokes",
  "album": "The New Abnormal",
  "tuning": "Standard",
  "master_bpm": 97,
  "notes": "No amp+cab block — running into tube amp. Amp voicing compensated via Parametric EQ. Delays are tempo-synced to 97 BPM. Three snapshots: rhythm, lead shimmer (Poly Pitch octave-up), and fuzz solo (Wringer Fuzz).",
  "signal_chain": [
    "Noise Gate",
    "Stupor OD",
    "Wringer Fuzz",
    "Poly Pitch",
    "Parametric EQ",
    "Adriatic Delay",
    "Ganymede"
  ],
  "blocks": {
    "noise_gate": {
      "model": "Noise Gate",
      "based_on": "Line 6 Original",
      "snapshots": {
        "1_rhythm": { "Threshold": -62, "Decay": 28, "Level": 0 },
        "2_lead_shimmer": { "Threshold": -60, "Decay": 25, "Level": 0 },
        "3_fuzz_solo": { "Threshold": -55, "Decay": 22, "Level": 0 }
      }
    },
    "overdrive": {
      "model": "Stupor OD",
      "based_on": "BOSS SD-1 Super OverDrive",
