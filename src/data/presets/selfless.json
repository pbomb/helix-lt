  "snapshots": {
    "1_rhythm": {
      "footswitch": "FS1",
      "description": "Warm, barely overdriven rhythm tone. Subtle Poly Pitch octave-up shimmer at 12% mix — barely audible, adds gentle organic movement. Triplet quarter delay at moderate mix.",
      "pickup_position": "Neck"
    },
    "2_lead_shimmer": {
      "footswitch": "FS2",
      "description": "Lead shimmer tone with more prominent Poly Pitch octave-up at 22% mix. Approximates EHX POG2 shimmery, slightly synth-like quality. Very clean — OD barely on.",
      "pickup_position": "Neck"
    },
    "3_fuzz_solo": {
      "footswitch": "FS3",
      "description": "Fuzz solo tone. Stupor OD and Poly Pitch both bypassed. Wringer Fuzz active at Gain 7.5. EQ opens up — wider mid Q at 1.0kHz, High Gain +1dB, High Cut 9kHz. BBD Size 4096 for warmer solo delay.",
      "pickup_position": "Bridge"
    }
  },
  "playing_notes": {
    "tuning": "Standard",
    "key": "B minor",
    "capo": null,
    "pickup_notes": "Neck pickup for Snapshots 1 and 2. Bridge pickup for Snapshot 3 fuzz solo.",
    "technique": "Delicate single-note figures and open chord voicings picked rather than strummed. Pick lightly for Snapshots 1 and 2. Dig in more for Snapshot 3.",
    "snapshot_cues": "Snapshot 1 for main rhythm and intro. Snapshot 2 for lead shimmer passages where the POG-like octave shimmer becomes more audible. Snapshot 3 for the fuzz solo — switch to bridge pickup simultaneously.",
    "tone_control": "Roll guitar tone knob back slightly to around 7 for Snapshot 3 — Wringer Fuzz can get bright through Lace Sensors."
  }
