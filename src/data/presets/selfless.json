        "2_lead_shimmer": { "active": true, "Drive": 2.5, "Tone": 5.5, "Level": 7.0 },
        "3_fuzz_solo": { "active": false, "Drive": 3.5, "Tone": 5.0, "Level": 7.0 }
      }
    },
    "fuzz": {
